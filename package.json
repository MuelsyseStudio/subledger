{
  "name": "subledger",
  "version": "1.3.0",
  "description": "Personal software subscription, game top-up amortization & monthly ledger manager (Web UI + CLI)",
  "type": "module",
  "bin": {
    "subledger": "./bin/subledger.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zianxu78-ux/subledger.git"
  },
  "scripts": {
    "start": "node ./bin/subledger.mjs open",
